{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sb-emulator-ns",
        "Queues": [
          {
            "Name": "pix-payments-session",
            "Properties": {
              "RequiresSession": true,
              "DeadLetteringOnMessageExpiration": true,
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT10M",
              "MaxDeliveryCount": 10,
              "RequiresDuplicateDetection": true
            }
          },
          {
            "Name": "pix-cobranca",
            "Properties": {
              "RequiresSession": false,
              "DeadLetteringOnMessageExpiration": true,
              "MaxDeliveryCount": 10
            }
          },
          {
            "Name": "pix-cashout-requested",
            "Properties": {
              "RequiresSession": true,
              "DeadLetteringOnMessageExpiration": true,
              "DefaultMessageTimeToLive": "PT1H",
              "DuplicateDetectionHistoryTimeWindow": "PT10M",
              "MaxDeliveryCount": 10,
              "RequiresDuplicateDetection": true
            }
          },
          {
            "Name": "pix-callbacks",
            "Properties": {
              "RequiresSession": false,
              "DeadLetteringOnMessageExpiration": true,
              "MaxDeliveryCount": 5
            }
          }
        ],
        "Topics": [
          {
            "Name": "pix-events",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H"
            },
            "Subscriptions": [
              {
                "Name": "outbank-connector-sub",
                "Properties": {
                  "RequiresSession": true,
                  "MaxDeliveryCount": 10
                }
              },
              {
                "Name": "webhook-dispatcher-sub",
                "Properties": {
                  "RequiresSession": false,
                  "MaxDeliveryCount": 5
                }
              }
            ]
          },
          {
            "Name": "pix-cashout-completed",
            "Properties": {
              "DefaultMessageTimeToLive": "PT1H"
            },
            "Subscriptions": [
              {
                "Name": "pix-processing-sub",
                "Properties": {
                  "RequiresSession": false,
                  "MaxDeliveryCount": 10
                }
              },
              {
                "Name": "webhook-dispatcher-sub",
                "Properties": {
                  "RequiresSession": false,
                  "MaxDeliveryCount": 5
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
