{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "cashout-root-route": {
        "ClusterId": "cashout-cluster",
        "Match": {
          "Path": "/api/v1/cashout"
        }
      },
      "cashout-route": {
        "ClusterId": "cashout-cluster",
        "Match": {
          "Path": "/api/v1/cashout/{**catch-all}"
        }
      },
      "pix-root-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/pix"
        }
      },
      "pix-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/v1/pix/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cashout-cluster": {
        "HttpRequest": {
          "Timeout": "00:00:15",
          "Version": "2.0"
        },
        "Destinations": {
          "cashout-api": {
            "Address": "http://ca-pix-cashout:8080"
          }
        }
      },
      "payment-cluster": {
        "HttpRequest": {
          "Timeout": "00:00:15",
          "Version": "2.0"
        },
        "Destinations": {
          "payment-api": {
            "Address": "http://ca-pix-payment:8080"
          }
        }
      }
    }
  }
}
