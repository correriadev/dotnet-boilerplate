<mxfile host="65bd71144e" compressed="false">
    <diagram id="page-1" name="01 • Contexto e tese arquitetural">
        <mxGraphModel dx="2850" dy="3464" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=24;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;01 • Contexto e tese arquitetural&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plataforma Pix • TO BE • Material para banca • Baseline documental: 04/10/2026. Comece pela pergunta: como aceitar rápido sem perder a segurança de um efeito financeiro externo?" vertex="1">
                    <mxGeometry height="165" width="1520" x="40" y="-40" as="geometry"/>
                </mxCell>
                <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;LEGENDA / ESCOPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Azul: aplicação/domínio • Verde: persistência • Roxo: mensagens • Amarelo: condições e riscos • Cinza: externo/contexto. Setas indicam fluxo operacional; página 5 indica dependências de código. TO BE = desenho de destino, sem certificação de implementação ou produção." vertex="1">
                    <mxGeometry height="75" width="1520" x="40" y="1000" as="geometry"/>
                </mxCell>
                <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Problema de negócio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cliente precisa de aceite durável, acompanhamento e conclusão. Rede e processos falham; pedidos e mensagens podem repetir. Aceitar uma solicitação não comprova liquidação." vertex="1">
                    <mxGeometry height="240" width="490" x="40" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Tese do desenho&lt;/b&gt;&lt;br&gt;&lt;br&gt;Separar aceite HTTP de execução bancária; preservar identidade, ordem por conta e evidência. Banco protege invariantes locais; reconciliação resolve a fronteira externa." vertex="1">
                    <mxGeometry height="240" width="490" x="555" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;O que 202 significa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Somente após commit: pedido registrado e recuperável. Resultado financeiro chega depois. Compatibilidade do 202, códigos e payloads depende do contrato legado homologado." vertex="1">
                    <mxGeometry height="240" width="490" x="1070" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Processamento Pix • autoridade local&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pedido, aceite, idempotência, execução e coordenação da conta. Conector e reconciliação são processos do mesmo contexto; não são autoridades financeiras concorrentes." vertex="1">
                    <mxGeometry height="240" width="490" x="40" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Contextos de apoio&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cobrança possui QR/geração; Entrega de callbacks possui tentativas; Consulta financeira possui projeção/cache. Fronteira de domínio não exige um microsserviço por contexto." vertex="1">
                    <mxGeometry height="240" width="490" x="555" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Autoridade financeira externa&lt;/b&gt;&lt;br&gt;&lt;br&gt;Outbank integra eBank/LI/GI via ACL. Fonte de saldo, reserva, liquidação e evidência deve ser homologada; não presumir que todos esses papéis pertencem ao mesmo sistema." vertex="1">
                    <mxGeometry height="240" width="490" x="1070" y="430" as="geometry"/>
                </mxCell>
                <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Consistência escolhida&lt;/b&gt;&lt;br&gt;&lt;br&gt;ACID dentro da transação local. Consistência eventual entre contextos e na notificação. Entrega at-least-once: duplicatas são esperadas e tratadas por identidade/estado." vertex="1">
                    <mxGeometry height="240" width="490" x="40" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Trade-off para a banca&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mais registros, estados e operação de recuperação em troca de rastreabilidade. Conta incerta bloqueia dependentes: segurança financeira reduz disponibilidade dessa conta." vertex="1">
                    <mxGeometry height="240" width="490" x="555" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Critério de sucesso&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recuperar após crash sem perder aceite/conclusão nem reenviar cegamente. Demonstrar ordem, deduplicação e transições com falhas reais; P99 de entrada &amp;lt;300 ms é meta sob perfil acordado." vertex="1">
                    <mxGeometry height="240" width="490" x="1070" y="700" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="page-2" name="02 • Mapa operacional de componentes">
        <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=24;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;02 • Mapa operacional de componentes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Visão de destino • Setas = chamadas ou mensagens rotuladas. Persistência é propriedade do contexto; banco físico compartilhado não autoriza escrita cruzada." vertex="1">
                    <mxGeometry height="160" width="1520" x="-80" y="-60" as="geometry"/>
                </mxCell>
                <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;LEGENDA / ESCOPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Azul: aplicação/domínio • Verde: persistência • Roxo: mensagens • Amarelo: condições e riscos • Cinza: externo/contexto. Setas indicam fluxo operacional; página 5 indica dependências de código. TO BE = desenho de destino, sem certificação de implementação ou produção." vertex="1">
                    <mxGeometry height="75" width="1520" x="50" y="1620" as="geometry"/>
                </mxCell>
                <mxCell id="n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Clientes / distribuidores&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTTPS • identidade • conta autorizada&lt;br&gt;Chave idempotente e contrato versionado" vertex="1">
                    <mxGeometry height="160" width="300" x="-80" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Hosts HTTP .NET 8&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pix.CashOut.Api / Pix.Payment.Api&lt;br&gt;Application comum de aceite&lt;br&gt;Consulta: cache-aside" vertex="1">
                    <mxGeometry height="160" width="480" x="420" y="170" as="geometry"/>
                </mxCell>
                <mxCell id="n5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;PostgreSQL • Processamento&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pedido + idempotência + coordenação&lt;br&gt;processed_ids + Outbox + pendências&lt;br&gt;Transações curtas; autoridade local" vertex="1">
                    <mxGeometry height="180" width="520" x="1020" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="n6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Outbox Relay&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lotes/paginação • lease recuperável&lt;br&gt;Publica fora da TX; marca com CAS&lt;br&gt;Mesmo evento mantém identidade" vertex="1">
                    <mxGeometry height="160" width="520" x="1010" y="760" as="geometry"/>
                </mxCell>
                <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Azure Service Bus • destino&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fila financeira comum com Sessions&lt;br&gt;SessionId = ContaId • MessageId estável&lt;br&gt;Conclusão em tópico/subscriptions&lt;br&gt;Dedup temporária + DLQ" vertex="1">
                    <mxGeometry height="200" width="480" x="290" y="740" as="geometry"/>
                </mxCell>
                <mxCell id="n8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Outbank.Connector&lt;/b&gt;&lt;br&gt;&lt;br&gt;Valida sequência no banco&lt;br&gt;Adquire execução; registra intenção&lt;br&gt;ACL traduz contrato externo" vertex="1">
                    <mxGeometry height="210" width="300" x="-100" y="510" as="geometry"/>
                </mxCell>
                <mxCell id="n9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Outbank / origem homologada&lt;/b&gt;&lt;br&gt;&lt;br&gt;Envio e consulta de evidência&lt;br&gt;HTTP/protocolo fora da transação&lt;br&gt;Timeout pode esconder execução" vertex="1">
                    <mxGeometry height="180" width="300" x="-100" y="1170" as="geometry"/>
                </mxCell>
                <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Consumidores de conclusão&lt;/b&gt;&lt;br&gt;&lt;br&gt;Webhook.Dispatcher → receptor HTTPS&lt;br&gt;Consulta → invalidação de cache&lt;br&gt;Cobrança: solicitação/resultado com Inbox + Outbox próprios" vertex="1">
                    <mxGeometry height="190" width="480" x="290" y="1070" as="geometry"/>
                </mxCell>
                <mxCell id="n11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;align=left;verticalAlign=top;spacing=16;overflow=hidden;" value="&lt;b&gt;Reconciliação + scheduler&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pix.Reconciliation.Worker&lt;br&gt;Resolve incerteza por evidência&lt;br&gt;Retoma pendência READY elegível&lt;br&gt;Usa o mesmo protocolo de estados" vertex="1">
                    <mxGeometry height="190" width="520" x="1050" y="1370" as="geometry"/>
                </mxCell>
                <mxCell id="e12" edge="1" parent="1" source="n3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n4" value="HTTP">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e13" edge="1" parent="1" source="n4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n5" value="TX-01">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e14" edge="1" parent="1" source="n5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n6" value="lote pendente">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1380" y="450"/>
