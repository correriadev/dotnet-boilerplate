                </mxCell>
                <mxCell id="e15" edge="1" parent="1" source="n6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n7" value="publicação">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e16" edge="1" parent="1" source="n7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n8" value="comando / sessão">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e17" edge="1" parent="1" source="n8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n9" value="ACL">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="-20" y="950"/>
                            <mxPoint x="-20" y="950"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e18" edge="1" parent="1" source="n8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n5" value="TX-02 / TX-03">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e19" edge="1" parent="1" source="n7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n10" value="eventos">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e20" edge="1" parent="1" source="n11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;" target="n5" value="CAS / pendências">
